# JanSetu Frontend Production Environment Variables Template
# Copy to .env.production or configure in your deployment hosting dashboard (Vercel, Netlify, Render, etc.)

# Backend Node.js API Gateway URL (default in dev: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# FastAPI AI Engine direct URL (optional, defaults to backend gateway)
VITE_AI_ENGINE_URL=http://localhost:8000

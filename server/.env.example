# JanSetu Node.js Backend API Gateway Environment Configuration
# Copy this to .env in production

PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection URL
# e.g., postgresql://postgres:password@localhost:5432/jansetu
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jansetu

# JWT Authentication Secret Key (generate a secure random 32+ character string in production)
JWT_SECRET=jansetu_jwt_super_secret_key_2026_jharkhand

# AI Engine FastAPI Service URL
AI_ENGINE_URL=http://localhost:8000

# Allowed CORS Origins (comma separated list or * for demo)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:5173
